<Window x:Class="MSSU_CIS310_MVC.KeywordUI"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:MSSU_CIS310_MVC"
      mc:Ignorable="d"
      Title="Oliver's Bible Browser - Search" Height="500" Width="600">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="24"/>
            <RowDefinition Height="24"/>
            <RowDefinition Height="24"/>
            <RowDefinition Height="30"/>
            <RowDefinition Height="190"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="24"/>
            <RowDefinition Height="24"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="2*"/>
            <ColumnDefinition Width="2*"/>
            <ColumnDefinition Width="60"/>
            <ColumnDefinition Width="70"/>
            <ColumnDefinition Width="60"/>
            <ColumnDefinition Width="60"/>
            <ColumnDefinition Width="140"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Label Content="Keyword:" Grid.Row="0" Grid.Column="0" HorizontalAlignment="Right"/>
        <Label Content="Translation:" Grid.Row="1" Grid.Column="0" HorizontalAlignment="Right" Margin="0,10,0,14" Grid.RowSpan="2"/>
        <Label Content="Between" Grid.Row="0" Grid.Column="2" HorizontalAlignment="Right"/>
        <Label Content="and" Grid.Row="0" Grid.Column="5" HorizontalAlignment="Center"/>
        <Label Content="Select Verses" Grid.Row="3" Grid.ColumnSpan="4" HorizontalAlignment="Center" FontFamily="Modern No. 20" FontSize="18"/>
        <Label Content="Output text" Grid.Row="3" Grid.Column="4" Grid.ColumnSpan="4" HorizontalAlignment="Center" FontFamily="Modern No. 20" FontSize="18"/>
        <Label Content="Places mentioned" Grid.Row="5" Grid.Column="4" Grid.ColumnSpan="4" HorizontalAlignment="Center" FontFamily="Modern No. 20" FontSize="18"/>

        <TextBox x:Name="txtKeyword" Grid.Row="0" Grid.Column="1" KeyDown="OnKeyDown" Focusable="True" Loaded="OnKeywordLoad"/>

        <ComboBox x:Name="translations" SelectionChanged="OnSelectTranslation" Grid.Row="1" Grid.Column="1" Margin="0,10,0,14" Grid.RowSpan="2"/>
        <ComboBox x:Name="lowerBook" SelectionChanged="OnSelectLowerBook" Grid.Row="0" Grid.Column="3" Grid.ColumnSpan="2"/>
        <ComboBox x:Name="upperBook" SelectionChanged="OnSelectUpperBook" Grid.Row="0" Grid.Column="6"/>

        <Button Content="Search" Click="SearchButtonClick" Grid.ColumnSpan="5" Grid.Column="2" Margin="23,10,10,10" Grid.Row="1" Grid.RowSpan="2"/>

        <Image Source="/img/manuscript.png" Grid.ColumnSpan="8" Grid.Row="4" Grid.RowSpan="2" Stretch="Fill" Opacity="0.5"/>
        <Image Source="/img/thebible.png" Grid.Column="4" Grid.ColumnSpan="4" Grid.Row="4" Grid.RowSpan="2" VerticalAlignment="Bottom" Margin="0,0,0,125">
            <Image.Style>
                <Style TargetType="Image">
                    <Setter Property="Opacity" Value="0.2" />
                </Style>
            </Image.Style>
        </Image>
        <Image Source="/img/candle.png" Grid.ColumnSpan="3" Grid.Row="4" Grid.RowSpan="2" VerticalAlignment="Bottom" Height="263" Margin="23,0,0,0">
            <Image.Style>
                <Style TargetType="Image">
                    <Setter Property="Opacity" Value="0.2" />
                </Style>
            </Image.Style>
        </Image>

        <Button Content="Read Text" Grid.Row="6" Grid.ColumnSpan="4" Click="ReadTextClick"/>
        <Button Content="Clear" Grid.Row="6" Grid.Column="4" Grid.ColumnSpan="4" Click="ClearTextClick"/>
        <Button Content="Go Back" Grid.Row="7" Grid.ColumnSpan="8" Click="BackButtonClick"/>

        <TextBlock x:Name="outputText" TextWrapping="WrapWithOverflow" Grid.ColumnSpan="4" Grid.Column="4" Grid.Row="4" Margin="10" FontFamily="Modern No. 20" FontSize="16"/>
        <TextBlock x:Name="tutorialText" TextWrapping="WrapWithOverflow" Grid.ColumnSpan="4" Grid.Row="4" Grid.RowSpan="2" Margin="10,10" FontFamily="Modern No. 20" FontSize="16"/>

        <ListBox Background="Transparent" x:Name="outputListBox" Grid.Row="4" Grid.RowSpan="2" Grid.ColumnSpan="4" FontFamily="Modern No. 20" FontSize="18"/>
        <ListBox Background="Transparent" x:Name="placesMentionedListBox" Grid.Row="5" Grid.Column="4" Grid.ColumnSpan="4" FontSize="12" Margin="0,27,0,0"/>

        <Border BorderBrush="Black" BorderThickness="2" Grid.Row="4" Grid.RowSpan="2" Grid.ColumnSpan="4"/>
        <Border BorderBrush="Black" BorderThickness="2" Grid.Row="4" Grid.Column="4" Grid.ColumnSpan="4"/>
        <Border BorderBrush="Black" BorderThickness="2" Grid.Row="5" Grid.Column="4" Grid.ColumnSpan="4"/>
        <Border BorderBrush="Black" BorderThickness="2" Grid.Row="3" Grid.ColumnSpan="4"/>
        <Border BorderBrush="Black" BorderThickness="2" Grid.Row="3" Grid.Column="4" Grid.ColumnSpan="4"/>
    </Grid>
</Window>
